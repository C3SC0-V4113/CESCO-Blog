{
  "name": "cesco-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "wrangler dev --local --port 8787",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run --configLoader native --pool=threads",
    "test:watch": "vitest --configLoader native --pool=threads",
    "test:e2e": "playwright test",
    "e2e:serve": "pnpm run db:migrate:local && pnpm run db:seed && pnpm run build && wrangler dev --local --ip 127.0.0.1 --port 3000",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "lint": "eslint . --no-warn-ignored --max-warnings 0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings 0",
    "doctor": "astro check --noSync && react-doctor . --yes --blocking warning",
    "doctor:staged": "astro check --noSync && react-doctor . --staged --blocking warning --no-score",
    "doctor:ci": "astro check --noSync && react-doctor . --yes --blocking warning --no-score",
    "scan:init": "astro dev --background",
    "scan": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check --noSync",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cesco-blog --local",
    "db:migrate:remote": "wrangler d1 migrations apply cesco-blog --remote",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts && wrangler d1 execute cesco-blog --local --file=.wrangler/seed.sql",
    "cf:types": "wrangler types src/env.d.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test && pnpm run doctor:ci",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/eslint-plugin": "1.6.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-react-doctor": "0.9.4",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "react-doctor": "0.9.4",
    "shadcn": "^4.16.1",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.8",
    "wrangler": "^4.118.0"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
