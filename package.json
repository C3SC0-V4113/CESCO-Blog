{
  "name": "cesco-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "wrangler dev --local --port 8787",
    "build": "astro build",
    "config:production": "pnpm run build && node scripts/deploy-production.ts --config-only",
    "deploy:production": "pnpm run build && node scripts/deploy-production.ts",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run --configLoader native --pool=threads",
    "test:watch": "vitest --configLoader native --pool=threads",
    "test:e2e": "playwright test",
    "e2e:serve": "node scripts/e2e-serve.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "lint": "eslint . --no-warn-ignored --max-warnings 0",
    "lint:fix": "eslint . --fix --no-warn-ignored --max-warnings 0",
    "doctor": "astro check --noSync && react-doctor . --yes --blocking warning",
    "doctor:staged": "astro check --noSync && react-doctor . --staged --blocking warning --no-score",
    "doctor:ci": "astro check --noSync && react-doctor . --yes --blocking warning --no-score",
    "scan:init": "astro dev --background",
    "scan": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check --noSync",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cesco-blog --local",
    "db:migrate:remote": "pnpm run config:production && wrangler d1 migrations apply cesco-blog --remote --config dist/server/wrangler.production.json",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts && node scripts/execute-seed.ts && sh .wrangler/seed-media.sh",
    "cf:types": "wrangler types src/env.d.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test && pnpm run doctor:ci",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@astrojs/rss": "^4.0.19",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-unique-id": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "shiki": "4.4.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "eslint --fix --no-warn-ignored --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/eslint-plugin": "1.6.27",
    "devalue": "5.9.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-doctor": "0.9.17",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-doctor": "0.9.17",
    "schema-dts": "^2.1.0",
    "shadcn": "^4.21.4",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a"
}
