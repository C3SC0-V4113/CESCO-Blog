---
import { buttonVariants } from '@/components/ui/button';
import { getTranslations } from '@/i18n/utils';

import type { Locale } from '@/i18n/locales';

/**
 * Theme toggle — **not an island**.
 *
 * ADR-0019 says to cut by `cva` rather than by React: where a registry
 * primitive only contributes style, import its variant function into the
 * `.astro` file instead of shipping the component. That is exactly this case.
 * The button needs shadcn's appearance and four lines of DOM work, and React is
 * a heavy way to attach a click handler.
 *
 * Which icon shows is decided by CSS through the `dark:` variant, so there is
 * no state to hold and nothing to hydrate. The crossfade obeys ADR-0022:
 * `opacity` and `transform` only, under 300 ms, with its own reduced-motion
 * block. A theme toggle is pressed rarely, so it is not one of the
 * high-frequency controls that ADR asks to keep instant.
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const label = t('theme.toggle');
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class={buttonVariants({ variant: 'ghost', size: 'icon' })}
>
  <span class="theme-icons grid place-items-center">
    <svg
      class="sun size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>

    <svg
      class="moon size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </span>
</button>

<script is:inline>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      // Unavailable storage flips the theme for this page without remembering
      // it, which beats breaking the button.
    }
  });
</script>

<style>
  /* Both icons occupy the same grid cell, so the swap is a crossfade rather
     than a reflow — ADR-0022 allows transform and opacity and nothing else. */
  .theme-icons > * {
    grid-area: 1 / 1;
    transition:
      opacity 150ms var(--ease-out-quad),
      transform 150ms var(--ease-out-quad);
  }

  .moon,
  :global(.dark) .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.95);
  }

  :global(.dark) .moon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-icons > * {
      transition: none;
    }
  }
</style>
