---
import type { ContentDoc } from '@/lib/content/schema';

/**
 * Renders a validated `content_json` document as markup (ADR-0019).
 *
 * No island. The article body is the least interactive surface on the site, so
 * it ships as server-rendered HTML and costs the reader no JavaScript at all.
 *
 * Every block carries its `blockId` as the element `id`. Those are the same
 * identifiers the table of contents anchors to and that `post_revision_media`
 * keys placements by, so a deep link survives a heading being reworded
 * (ADR-0012).
 */

interface Props {
  doc: ContentDoc;
}

const { doc } = Astro.props;

// Drafts can hold image nodes now (ADR-0036), but only publication turns a
// draft into a revision (ADR-0032), and public rendering of images — the
// placement rows and the markup — arrives with that publish flow. Until then no
// revision this component receives should contain one. Failing here is
// deliberate: rendering the document without them would drop content silently,
// and a missing image in a published article is worth an error rather than a
// gap nobody notices.
const unsupported = doc.content.find((block) => block.type === 'image');

if (unsupported) {
  throw new Error(
    `Cannot render an image node yet (blockId ${unsupported.attrs.blockId}). ` +
      `Public image rendering arrives with the publish flow.`
  );
}
---

{
  doc.content.map((block) => {
    if (block.type === 'heading') {
      const Heading = `h${block.attrs.level}` as 'h1';
      return <Heading id={block.attrs.blockId}>{block.content.map((node) => node.text)}</Heading>;
    }

    if (block.type === 'codeBlock') {
      return (
        <pre id={block.attrs.blockId}>
          <code class={block.attrs.language ? `language-${block.attrs.language}` : undefined}>
            {block.content.map((node) => node.text)}
          </code>
        </pre>
      );
    }

    if (block.type === 'paragraph') {
      return <p id={block.attrs.blockId}>{block.content.map((node) => node.text)}</p>;
    }

    return null;
  })
}
