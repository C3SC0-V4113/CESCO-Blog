---
import { getTranslations } from '@/i18n/utils';
import { mediaPath, safeExternalUrl } from '@/lib/media';

import type { PublishedMedia } from '@/db/queries/posts';
import type { Locale } from '@/i18n/locales';
import type { PublishedContentDoc } from '@/lib/content/schema';

interface Props {
  doc: PublishedContentDoc;
  locale: Locale;
  media: PublishedMedia[];
}

const { doc, locale, media } = Astro.props;
const t = getTranslations(locale);
---

{
  doc.content.map((block) => {
    if (block.type === 'heading') {
      const Heading = `h${block.attrs.level}` as 'h1';
      return <Heading id={block.attrs.blockId}>{block.content.map((node) => node.text)}</Heading>;
    }

    if (block.type === 'codeBlock') {
      return (
        <pre id={block.attrs.blockId}>
          <code class={block.attrs.language ? `language-${block.attrs.language}` : undefined}>
            {block.attrs.highlighted
              ? block.attrs.highlighted.map((line, lineIndex) => (
                  <Fragment>
                    {line.map((token) => (
                      <span style={token.color ? `color:${token.color}` : undefined}>
                        {token.content}
                      </span>
                    ))}
                    {lineIndex < block.attrs.highlighted!.length - 1 ? '\n' : ''}
                  </Fragment>
                ))
              : block.content.map((node) => node.text)}
          </code>
        </pre>
      );
    }

    if (block.type === 'paragraph')
      return <p id={block.attrs.blockId}>{block.content.map((node) => node.text)}</p>;

    if (block.type === 'image') {
      const asset = media.find((item) => item.blockId === block.attrs.blockId);
      if (!asset) throw Error(`Published media placement missing: ${block.attrs.blockId}`);
      const sourceUrl = safeExternalUrl(asset.sourceUrl);
      const licenseUrl = safeExternalUrl(asset.licenseUrl);
      return (
        <figure id={block.attrs.blockId}>
          <img
            src={mediaPath(asset.r2Key)}
            width={asset.width ?? undefined}
            height={asset.height ?? undefined}
            alt={asset.altText ?? ''}
          />
          {(asset.caption || asset.credit || sourceUrl || asset.licenseLabel) && (
            <figcaption>
              {asset.caption && <span>{asset.caption}</span>}
              {asset.credit && (
                <span>
                  {' '}
                  {t('post.media.by')} {asset.credit}
                </span>
              )}
              {sourceUrl && (
                <span>
                  {' '}
                  <a href={sourceUrl}>{t('post.media.source')}</a>
                </span>
              )}
              {asset.licenseLabel && (
                <span>
                  {' '}
                  {licenseUrl ? <a href={licenseUrl}>{asset.licenseLabel}</a> : asset.licenseLabel}
                </span>
              )}
            </figcaption>
          )}
        </figure>
      );
    }

    return null;
  })
}
