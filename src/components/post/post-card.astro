---
import { formatDate, getTranslations } from '@/i18n/utils';
import { COVER_HEIGHT, COVER_WIDTH } from '@/lib/cover';
import { mediaPath } from '@/lib/media';
import { articlePath } from '@/lib/urls';

import type { PostSummary } from '@/db/queries/listings';
import type { Locale } from '@/i18n/locales';

/**
 * One post in a listing (ADR-0019, ADR-0021).
 *
 * `.astro`, and repeated twenty times on a page — which is exactly the case
 * DESIGN.md says the Astro-first preference matters most for, since every
 * repetition of a React component is server CPU spent rendering the same markup.
 *
 * Everything shown comes from the row the listing query already fetched. The
 * card never reaches for the database, which is what keeps a twenty-post page
 * at two queries instead of twenty-one (ADR-0016).
 *
 * **The section is the one thing here wearing the brand colour.** A listing is
 * mostly text, so the accent has to earn its place rather than decorate: used on
 * the one label that tells you what kind of piece this is, it becomes the thing
 * the eye scans down the page. Used on the titles as well it would stop meaning
 * anything.
 *
 * The hover lifts the whole row rather than only the link. `group` puts the
 * state on the `article` while the anchor stays the only focusable thing in it,
 * so pointer and keyboard land on the same target and nothing is clickable that
 * does not announce itself.
 */

interface Props {
  locale: Locale;
  post: PostSummary;
}

const { locale, post } = Astro.props;
const t = getTranslations(locale);

const href = articlePath(locale, post.section, post.slug);
const sectionLabel = post.section === 'analysis' ? t('nav.analysis') : t('nav.opinion');
---

<article
  class="group grid gap-x-5 gap-y-4 border-b border-border py-8 last:border-b-0 sm:grid-cols-[1fr_10rem]"
>
  <div class="sm:order-1">
    <p
      class="text-[0.6875rem] font-medium tracking-[0.14em] text-primary uppercase transition-colors duration-150"
    >
      {sectionLabel}
    </p>

    <h2 class="mt-3 text-2xl leading-[1.25] text-balance">
      <a
        href={href}
        class="decoration-primary/40 underline-offset-[6px] transition-colors duration-150 group-hover:underline hover:text-primary"
      >
        {post.title}
      </a>
    </h2>

    {
      post.excerpt && (
        <p class="mt-3 leading-relaxed text-pretty text-muted-foreground">{post.excerpt}</p>
      )
    }

    {
      /*
    The metadata line is deliberately quieter than everything above it: smaller,
    wider-tracked and muted. It is what a reader checks *after* deciding the
    title is interesting, so it should not compete with the title for that
    decision.
  */
    }
    <p
      class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs tracking-wide text-muted-foreground"
    >
      {post.authorName && <span>{post.authorName}</span>}
      {post.authorName && post.publishedAt && <span aria-hidden="true">·</span>}
      {
        post.publishedAt && (
          <time datetime={post.publishedAt.replace(' ', 'T') + 'Z'}>
            {formatDate(post.publishedAt, locale)}
          </time>
        )
      }
      {post.readingTimeMinutes !== null && <span aria-hidden="true">·</span>}
      {
        post.readingTimeMinutes !== null && (
          <span>
            {post.readingTimeMinutes} {t('post.readingTime')}
          </span>
        )
      }
    </p>
  </div>

  {
    /*
      The cover, at a tenth of its stored width.
      
      `loading="lazy"` and explicit dimensions together: the first reserves the
      request, the second reserves the space. Without the dimensions a listing
      of twenty covers reflows twenty times as they arrive, which is the layout
      shift ADR-0028 records the stored width and height to prevent.
      
      Empty `alt`, deliberately. These are generated shapes carrying no
      information a reader would miss, so announcing them would add noise to a
      screen reader without adding meaning. The title beside it is the label.
    */
  }
  {
    post.coverKey && (
      <a
        href={href}
        tabindex="-1"
        aria-hidden="true"
        class="block self-start overflow-hidden rounded-md border border-border sm:order-2"
      >
        <img
          src={mediaPath(post.coverKey)}
          alt=""
          width={COVER_WIDTH}
          height={COVER_HEIGHT}
          loading="lazy"
          decoding="async"
          class="aspect-[1200/628] w-full object-cover transition-transform duration-300 ease-[var(--ease-out-quad)] group-hover:scale-[1.03] motion-reduce:transition-none"
        />
      </a>
    )
  }
</article>
