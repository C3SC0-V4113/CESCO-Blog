---
import type { TocEntry } from '@/lib/content/schema';

/**
 * The outline itself, without any of the presentation around it.
 *
 * Extracted because the article renders it twice — once inside the mobile
 * disclosure, once in the desktop sidebar — and the anchors are the part that
 * must not drift between the two.
 *
 * Every `href` is a **block ID**, never a slug of the heading text (ADR-0012).
 */

interface Props {
  entries: TocEntry[];
}

const { entries } = Astro.props;
---

{
  /*
  A rule down the left, with the current entry marking itself on it.
  
  The highlight used to be a colour change alone, which is the weakest signal
  available in a list where every item is already text: at a glance nothing
  moved. The border gives the eye a position to find rather than a shade to
  compare, and the accent is doing the one job it is best at — saying "here".
*/
}
<ol class="space-y-1 border-s border-border text-sm">
  {
    entries.map((entry) => (
      <li>
        <a
          href={`#${entry.id}`}
          data-toc-link={entry.id}
          class:list={[
            '-ms-px block border-s border-transparent py-1 ps-3 text-muted-foreground transition-colors duration-150',
            'hover:border-border hover:text-foreground',
            'aria-[current]:border-primary aria-[current]:text-foreground',
            entry.level === 3 && 'ps-6',
          ]}
        >
          {entry.text}
        </a>
      </li>
    ))
  }
</ol>
