---
import Pagination from '@/components/common/pagination.astro';
import PostCard from '@/components/post/post-card.astro';
import { getTranslations } from '@/i18n/utils';

import type { PostSummary } from '@/db/queries/listings';
import type { Locale } from '@/i18n/locales';

/**
 * A titled, paginated list of posts — the shape every listing surface shares.
 *
 * The empty state is not an edge case here. Locales publish independently
 * (ADR-0008), so a language with nothing published yet is the normal early
 * condition rather than a failure, and it gets a sentence instead of a blank
 * page.
 */

interface Props {
  locale: Locale;
  heading: string;
  description?: string | undefined;
  posts: PostSummary[];
  basePath: string;
  page: number;
  totalPages: number;
}

const { locale, heading, description, posts, basePath, page, totalPages } = Astro.props;
const t = getTranslations(locale);
---

<main class="mx-auto max-w-3xl px-6 pt-12 pb-20">
  <header class="mb-8">
    <h1 class="text-3xl leading-tight text-balance">{heading}</h1>
    {
      description && (
        <p class="mt-3 leading-relaxed text-pretty text-muted-foreground">{description}</p>
      )
    }
  </header>

  {
    posts.length === 0 ? (
      <p class="text-muted-foreground">{t('listing.empty')}</p>
    ) : (
      <div>
        {posts.map((post) => (
          <PostCard locale={locale} post={post} />
        ))}
      </div>
    )
  }

  <Pagination locale={locale} basePath={basePath} page={page} totalPages={totalPages} />
</main>
