---
/**
 * Typographic wrapper for long-form content (ADR-0021).
 *
 * Merriweather carries the headings and Figtree the body copy: the serif gives
 * the page the authority of a publication, but it is a heavy serif and reads
 * worse than Figtree at paragraph length, so it stops at the headings.
 *
 * Every value here is a token. No colour and no radius is written literally, so
 * both themes stay correct without per-component work.
 *
 * **This is the exception to ADR-0030, and the only one.** Components are styled
 * with Tailwind utilities; scoped CSS is reserved for styling slotted content a
 * component does not own. That is exactly this file's job — it sets a type scale
 * across `h2`, `h3`, `p`, `pre`, `code` and `figure` whose markup it never
 * writes. As utilities that becomes `[&_h2]:font-heading [&_h2]:text-2xl
 * [&_h2]:mt-10 …` repeated per element, which stops resembling the CSS it
 * compiles to.
 *
 * Do not take this as licence to add scoped blocks elsewhere: a component's own
 * markup gets utilities, where they read fine.
 *
 * Scope note: this styles the content it wraps. The site-wide `@layer base`
 * rule that ADR-0021 also calls for — the one that makes `--font-heading`
 * non-inert everywhere — belongs with the design system, not here.
 */
---

<div class="typeset typeset-article max-w-136">
  <slot />
</div>

<style>
  .typeset :global(h2, h3) {
    text-wrap: balance;
  }

  .typeset :global(p) {
    text-wrap: pretty;
  }

  .typeset :global(pre) {
    margin-block: 0 1.5em;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--muted);
    overflow-x: auto;
    font-family: var(--font-sans);
    font-size: inherit;
    line-height: inherit;
  }

  .typeset :global(code) {
    background-color: transparent;
    font-family: ui-monospace, monospace;
    font-size: 0.9375em;
    padding: 0;
    border-radius: 0;
  }

  .typeset :global(figure) {
    margin-block: 0 1.5em;
    margin-inline: 40px;
  }

  /* The same hairline as the covers, for the same reason: an image whose edge
     matches the page has no edge at all. */
  .typeset :global(figure img) {
    border-radius: var(--radius-md);
    outline: 1px solid var(--image-outline);
    outline-offset: -1px;
    margin-block-start: 0;
  }

  /* Credits and captions are read after the image, so they step back from it. */
  .typeset :global(figcaption) {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted-foreground);
    text-align: initial;
  }

  /*
   * Links in body copy are the second place the accent appears, and the only
   * one inside the reading column.
   *
   * Underlined rather than coloured alone: colour is not available to every
   * reader, and an underline is the one link affordance that survives both
   * colour blindness and a monochrome print. The offset and the thin rule keep
   * it from cutting through descenders, which is what makes underlines look
   * cheap.
   */
  .typeset :global(a) {
    color: var(--brand);
    font-weight: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--brand), transparent 55%);
    transition: text-decoration-color 150ms var(--ease-out-quad);
  }

  /* Gated like every hover in the project (ADR-0022): on touch, a tap would
     otherwise leave the underline stuck at full strength. */
  @media (hover: hover) and (pointer: fine) {
    .typeset :global(a:hover) {
      text-decoration-color: var(--brand);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typeset :global(a) {
      transition: none;
    }
  }
</style>
