---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    {
      import.meta.env.DEV && (
        <script
          is:inline
          defer
          crossorigin="anonymous"
          src="//unpkg.com/react-scan/dist/auto.global.js"
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
