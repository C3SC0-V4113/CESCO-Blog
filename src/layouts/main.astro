---
import SiteFooter from '@/components/common/site-footer.astro';
import SiteHeader from '@/components/common/site-header.astro';
import ThemeScript from '@/components/common/theme-script.astro';
import { resolveLocale } from '@/i18n/utils';

import '../styles/global.css';

import type { Locale } from '@/i18n/locales';

/**
 * `alternates` is where the same page lives in the other locales, and it is
 * optional because most pages cannot answer it. A listing knows; an article
 * knows only after resolving the sibling localization's slug; a `404` has no
 * counterpart at all.
 *
 * Supplied, the language picker sends a reader to the page they are on. Absent,
 * it falls back to that locale's home, which is where it used to always go.
 */
interface Props {
  alternates?: { locale: Locale; path: string }[];
}

const { alternates } = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <ThemeScript />

    {
      import.meta.env.DEV && (
        <script
          is:inline
          defer
          crossorigin="anonymous"
          src="//unpkg.com/react-scan/dist/auto.global.js"
        />
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader locale={locale} alternates={alternates} />
    <div id="main" class="flex-1">
      <slot />
    </div>
    <SiteFooter locale={locale} />
  </body>
</html>
