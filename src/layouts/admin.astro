---
import BaseLayout from '@/layouts/base.astro';

// Deliberately without `page-transitions.css`: the admin does not opt in to
// cross-document view transitions, so its navigations and reloads snap.

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout lang="es">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <meta slot="head" name="referrer" content="no-referrer" />
  <title slot="head">{title}</title>

  <slot />
</BaseLayout>
