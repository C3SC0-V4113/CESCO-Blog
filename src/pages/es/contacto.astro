---
import Prose from '@/components/common/prose.astro';
import SeoHead from '@/components/common/seo-head.astro';
import { resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { CONTACT_EMAIL } from '@/lib/site';

/**
 * A transparency page (ADR-0018).
 *
 * Static content, not a database row: these describe how the site operates
 * rather than being editorial output, so they live in the repository where a
 * change to them is a reviewed commit.
 *
 * ADR-0018 is explicit that these are reasonable transparency statements from
 * the site owner and not legal advice, and claims no regulatory compliance.
 */

const locale = resolveLocale(Astro.currentLocale);
---

<Layout>
  <Fragment slot="head">
    <SeoHead
      locale={locale}
      title="Contacto"
      path="/es/contacto"
      alternates={[
        { locale: 'es', path: '/es/contacto' },
        { locale: 'en', path: '/en/contact' },
      ]}
    />
  </Fragment>

  <main class="mx-auto max-w-[34rem] px-6 pt-12 pb-20">
    <h1 class="mb-8 text-3xl leading-tight text-balance">Contacto</h1>

    <Prose>
      <p>
        Para correcciones, comentarios o consultas editoriales, escriba a{' '}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Lo lee una persona, no un
        formulario.
      </p>
      <p>
        Si un análisis dice algo incorrecto sobre un juego, avise. Las correcciones de hechos se
        atienden siempre, y cuando una publicación se corrige queda dicho en la propia publicación.
      </p>
      <p>
        Los estudios y las distribuidoras también pueden escribir. Los pedidos de cobertura se leen
        todos, aunque no siempre haya respuesta y casi nunca haya promesa: qué se cubre se decide
        acá.
      </p>
    </Prose>
  </main>
</Layout>
