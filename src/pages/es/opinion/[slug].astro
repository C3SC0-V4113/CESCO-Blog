---
import ErrorState from '@/components/common/error-state.astro';
import SeoHead from '@/components/common/seo-head.astro';
import ArticleDetail from '@/components/post/article-detail.astro';
import ArticleJsonLd from '@/components/post/article-json-ld.astro';
import { findPostSeries } from '@/db/queries/collections';
import { resolveArticleUrl } from '@/db/queries/posts';
import { resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { ERROR_RESPONSE_MAX_AGE, cacheTagHeader, postDetailTags } from '@/lib/cache-tags';
import { mediaPath } from '@/lib/media';
import { articleAlternates } from '@/lib/routes';
import { getDb } from '@/lib/runtime';
import { absolute } from '@/lib/seo';
import { articlePath } from '@/lib/urls';

// See the Spanish analysis route for why each branch answers as it does.
const locale = resolveLocale(Astro.currentLocale);
const section = 'opinion';
const { slug } = Astro.params;

const resolution = slug
  ? await resolveArticleUrl(getDb(), { locale, section, slug })
  : ({ kind: 'not-found' } as const);

// Fetched only for a page that will render: a 404 or a 410 has no series to
// show, and spending two queries to decorate an error response is two queries
// the budget did not need to lose (ADR-0016).
const series =
  resolution.kind === 'render'
    ? await findPostSeries(getDb(), resolution.post.postId, locale)
    : null;

const redirectTo =
  resolution.kind === 'redirect' ? articlePath(locale, section, resolution.slug) : null;

if (redirectTo && resolution.kind === 'redirect') {
  return new Response(null, {
    status: 301,
    headers: {
      Location: redirectTo,
      'Cache-Tag': cacheTagHeader(postDetailTags(resolution.postId, locale, section)),
      'Cache-Control': `public, max-age=${ERROR_RESPONSE_MAX_AGE}`,
    },
  });
}

// Tagged by dependency rather than by URL (ADR-0011). Both localizations
// carry the same `post-{id}`, so publishing either purges both.
if (resolution.kind === 'render') {
  Astro.response.headers.set(
    'Cache-Tag',
    cacheTagHeader(postDetailTags(resolution.post.postId, locale, section))
  );
} else {
  // A long-lived cached 410 outlives the republication that should end it.
  Astro.response.headers.set('Cache-Control', `public, max-age=${ERROR_RESPONSE_MAX_AGE}`);
  if (resolution.kind === 'gone')
    Astro.response.headers.set(
      'Cache-Tag',
      cacheTagHeader(postDetailTags(resolution.postId, locale, section))
    );
}

if (resolution.kind === 'gone') Astro.response.status = 410;
if (resolution.kind === 'not-found') Astro.response.status = 404;
// Where this same article lives in the other locales, published ones only
// (ADR-0013). Computed once: the `<head>` needs it for `hreflang` and the
// language picker needs it to keep a reader on the page they are reading.
const alternates =
  resolution.kind === 'render' ? articleAlternates(section, resolution.post.alternates) : [];
---

<Layout alternates={alternates}>
  {
    resolution.kind === 'render' && (
      <Fragment slot="head">
        <SeoHead
          locale={locale}
          title={resolution.post.seo.title}
          description={resolution.post.seo.description}
          path={articlePath(locale, section, slug ?? '')}
          alternates={alternates}
          ogType="article"
          ogTitle={resolution.post.seo.ogTitle}
          ogDescription={resolution.post.seo.ogDescription}
          image={
            resolution.post.socialImage && {
              ...resolution.post.socialImage,
              src: mediaPath(resolution.post.socialImage.r2Key),
            }
          }
        />
        <ArticleJsonLd
          locale={locale}
          headline={resolution.post.title}
          description={resolution.post.seo.description}
          canonical={absolute(
            Astro.site?.toString() ?? Astro.url.origin,
            articlePath(locale, section, slug ?? '')
          )}
          authorName={resolution.post.authorName}
          publishedAt={resolution.post.publishedAt}
          updatedAt={resolution.post.updatedAt}
          image={
            resolution.post.cover
              ? absolute(
                  Astro.site?.toString() ?? Astro.url.origin,
                  mediaPath(resolution.post.cover.r2Key)
                )
              : null
          }
          authorWebsiteUrl={resolution.post.author?.websiteUrl}
          authorSameAs={resolution.post.author?.sameAs}
        />
      </Fragment>
    )
  }

  {
    resolution.kind === 'render' ? (
      <ArticleDetail locale={locale} post={resolution.post} series={series} />
    ) : (
      <ErrorState locale={locale} status={resolution.kind === 'gone' ? 410 : 404} />
    )
  }
</Layout>
