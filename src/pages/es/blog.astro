---
import PostList from '@/components/common/post-list.astro';
import SeoHead from '@/components/common/seo-head.astro';
import { listPublishedPosts } from '@/db/queries/listings';
import { getTranslations, resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { pageCount, readPageWindow } from '@/lib/pagination';
import { getDb } from '@/lib/runtime';

const locale = resolveLocale(Astro.currentLocale);
const t = getTranslations(locale);

const heading = t('nav.blog');

const { page, offset, limit } = readPageWindow(Astro.url.searchParams.get('page'));

const { posts, total } = await listPublishedPosts(getDb(), {
  locale,
  limit,
  offset,
});
---

<Layout>
  <Fragment slot="head">
    <SeoHead
      locale={locale}
      title={heading}
      path="/es/blog"
      alternates={[
        { locale: 'es', path: '/es/blog' },
        { locale: 'en', path: '/en/blog' },
      ]}
    />
  </Fragment>

  <PostList
    locale={locale}
    heading={heading}
    posts={posts}
    basePath="/es/blog"
    page={page}
    totalPages={pageCount(total)}
  />
</Layout>
