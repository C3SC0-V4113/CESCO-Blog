---
import Prose from '@/components/common/prose.astro';
import SeoHead from '@/components/common/seo-head.astro';
import { resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { routeAlternates } from '@/lib/routes';

/**
 * A transparency page (ADR-0018).
 *
 * Static content, not a database row: these describe how the site operates
 * rather than being editorial output, so they live in the repository where a
 * change to them is a reviewed commit.
 *
 * ADR-0018 is explicit that these are reasonable transparency statements from
 * the site owner and not legal advice, and claims no regulatory compliance.
 */

const locale = resolveLocale(Astro.currentLocale);

const alternates = routeAlternates('privacy');
---

<Layout alternates={alternates}>
  <Fragment slot="head">
    <SeoHead locale={locale} title="Privacidad" path="/es/privacidad" alternates={alternates} />
  </Fragment>

  <main class="mx-auto max-w-[34rem] px-6 pt-12 pb-20">
    <h1 class="mb-8 text-3xl leading-tight text-balance">Privacidad</h1>

    <Prose>
      <p>
        Nada de lo que hace aquí queda asociado a usted. No hay cookies, no hay perfiles, y no se
        vende ni se comparte información con anunciantes.
      </p>
      <p>
        Sí se llevan estadísticas de audiencia, porque saber qué se lee ayuda a decidir sobre qué
        escribir. Se miden a través de un servicio que funciona sin cookies ni identificadores
        persistentes y que no sigue a nadie de un sitio a otro: registra que una página se abrió, no
        quién la abrió.
      </p>
      <p>
        Leer aquí no requiere una cuenta, así que no hay ningún registro que guardar ni que pedirnos
        que borremos.
      </p>
    </Prose>
  </main>
</Layout>
