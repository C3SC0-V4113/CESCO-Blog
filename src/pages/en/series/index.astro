---
import SeoHead from '@/components/common/seo-head.astro';
import { listPublishedCollections } from '@/db/queries/collections';
import { getTranslations, resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { cacheTagHeader } from '@/lib/cache-tags';
import { routeAlternates } from '@/lib/routes';
import { getDb } from '@/lib/runtime';

/**
 * Series index (ADR-0012).
 *
 * This was a placeholder that printed the empty state unconditionally, which
 * meant a published series was reachable at its own URL and invisible from the
 * one page built to find it. The listing query is what it was waiting for.
 *
 * Tagged by locale (ADR-0011): publishing or withdrawing a series in this
 * language is what changes this page, and nothing else does.
 */
const locale = resolveLocale(Astro.currentLocale);
const t = getTranslations(locale);

const series = await listPublishedCollections(getDb(), locale);

Astro.response.headers.set('Cache-Tag', cacheTagHeader([`locale-${locale}`, 'series']));

const alternates = routeAlternates('series');
---

<Layout alternates={alternates}>
  <Fragment slot="head">
    <SeoHead locale={locale} title={t('nav.series')} path="/en/series" alternates={alternates} />
  </Fragment>

  <main class="mx-auto max-w-[34rem] px-6 pt-12 pb-20">
    <h1 class="text-3xl leading-tight text-balance">{t('nav.series')}</h1>

    {
      series.length === 0 ? (
        <p class="mt-3 text-muted-foreground">{t('series.empty')}</p>
      ) : (
        <ul class="mt-8">
          {series.map((collection) => (
            <li class="group border-b border-border py-8 last:border-b-0">
              <p class="text-[0.6875rem] font-medium tracking-[0.14em] text-primary uppercase">
                {collection.postCount}{' '}
                {t(collection.postCount === 1 ? 'series.piece' : 'series.pieces')}
              </p>

              <h2 class="mt-3 text-2xl leading-[1.25] text-balance">
                <a
                  href={`/${locale}/series/${collection.slug}`}
                  class="decoration-primary/40 underline-offset-[6px] transition-colors duration-150 group-hover:underline hover:text-primary"
                >
                  {collection.title}
                </a>
              </h2>

              {collection.description && (
                <p class="mt-3 leading-relaxed text-pretty text-muted-foreground">
                  {collection.description}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
