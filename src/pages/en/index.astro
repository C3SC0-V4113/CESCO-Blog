---
import PostList from '@/components/common/post-list.astro';
import SeoHead from '@/components/common/seo-head.astro';
import PostCard from '@/components/post/post-card.astro';
import { findFeaturedPost, listPublishedPosts } from '@/db/queries/listings';
import { getTranslations, resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { cacheTagHeader, homeTags } from '@/lib/cache-tags';
import { pageCount, readPageWindow } from '@/lib/pagination';
import { routeAlternates } from '@/lib/routes';
import { getDb } from '@/lib/runtime';

// See the Spanish home for why the featured slot is independent from recency.

const locale = resolveLocale(Astro.currentLocale);
const t = getTranslations(locale);

const heading = t('listing.latest');

const { page, offset, limit } = readPageWindow(Astro.url.searchParams.get('page'));

const [featured, { posts, total }] = await Promise.all([
  findFeaturedPost(getDb(), locale),
  listPublishedPosts(getDb(), { locale, limit, offset, excludeFeatured: true }),
]);

Astro.response.headers.set('Cache-Tag', cacheTagHeader(homeTags(locale)));

const alternates = routeAlternates('home');
---

<Layout alternates={alternates}>
  <Fragment slot="head">
    <SeoHead locale={locale} title={heading} path="/en/" alternates={alternates} />
  </Fragment>

  <PostList
    locale={locale}
    heading={heading}
    posts={posts}
    basePath="/en/"
    page={page}
    totalPages={pageCount(total)}
  >
    <Fragment slot="lead">
      {
        featured && (
          <section aria-labelledby="featured-heading" class="mb-10">
            <h2
              id="featured-heading"
              class="mb-4 text-xs font-medium tracking-[0.14em] text-muted-foreground uppercase"
            >
              {t('listing.featured')}
            </h2>
            <PostCard locale={locale} post={featured} featured />
          </section>
        )
      }
    </Fragment>
  </PostList>
</Layout>
