---
import PostList from '@/components/common/post-list.astro';
import SeoHead from '@/components/common/seo-head.astro';
import { listPublishedPosts } from '@/db/queries/listings';
import { getTranslations, resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { cacheTagHeader, homeTags } from '@/lib/cache-tags';
import { pageCount, readPageWindow } from '@/lib/pagination';
import { routeAlternates } from '@/lib/routes';
import { getDb } from '@/lib/runtime';

// See the Spanish home for why the featured slot and section rows are absent.

const locale = resolveLocale(Astro.currentLocale);
const t = getTranslations(locale);

const heading = t('listing.latest');

const { page, offset, limit } = readPageWindow(Astro.url.searchParams.get('page'));

const { posts, total } = await listPublishedPosts(getDb(), { locale, limit, offset });

Astro.response.headers.set('Cache-Tag', cacheTagHeader(homeTags(locale)));

const alternates = routeAlternates('home');
---

<Layout alternates={alternates}>
  <Fragment slot="head">
    <SeoHead locale={locale} title={heading} path="/en/" alternates={alternates} />
  </Fragment>

  <PostList
    locale={locale}
    heading={heading}
    posts={posts}
    basePath="/en/"
    page={page}
    totalPages={pageCount(total)}
  />
</Layout>
