---
import Prose from '@/components/common/prose.astro';
import SeoHead from '@/components/common/seo-head.astro';
import { resolveLocale } from '@/i18n/utils';
import Layout from '@/layouts/main.astro';
import { routeAlternates } from '@/lib/routes';

/**
 * A transparency page (ADR-0018).
 *
 * Static content, not a database row: these describe how the site operates
 * rather than being editorial output, so they live in the repository where a
 * change to them is a reviewed commit.
 *
 * ADR-0018 is explicit that these are reasonable transparency statements from
 * the site owner and not legal advice, and claims no regulatory compliance.
 */

const locale = resolveLocale(Astro.currentLocale);

const alternates = routeAlternates('privacy');
---

<Layout alternates={alternates}>
  <Fragment slot="head">
    <SeoHead locale={locale} title="Privacy" path="/en/privacy" alternates={alternates} />
  </Fragment>

  <main class="mx-auto max-w-[34rem] px-6 pt-12 pb-20">
    <h1 class="mb-8 text-3xl leading-tight text-balance">Privacy</h1>

    <Prose>
      <p>
        Nothing you do here is tied back to you. No cookies, no profiles, and nothing sold or handed
        to advertisers.
      </p>
      <p>
        Audience figures are kept, because knowing what gets read helps decide what to write next.
        They come from a service that works without cookies or persistent identifiers and does not
        follow anyone from one site to another: it records that a page was opened, not who opened
        it.
      </p>
      <p>
        Reading here takes no account, so there is no record to keep and nothing to ask us to
        delete.
      </p>
    </Prose>
  </main>
</Layout>
